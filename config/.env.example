PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=blind_assistant

DB_SYNCHRONIZE=false
DB_LOGGING=false

# Optional. Read directly by AppModule for NestJS Observe.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
JWT_SECRET=your_jwt_secret

# AI Agent Integration Settings (External Python / ML Service)
AI_VOICE_AGENT_URL=http://localhost:8000/api/v1
AI_VOICE_AGENT_API_KEY=
AI_VOICE_AGENT_TIMEOUT_MS=4000
AI_VOICE_AGENT_CLASSIFY_PATH=intent/classify
AI_VOICE_AGENT_TRANSCRIBE_PATH=speech/transcribe
AI_VOICE_AGENT_TRANSCRIBE_TIMEOUT_MS=8000

# Voice Audio Upload Limits (in bytes; default 5242880 = 5MB)
VOICE_AUDIO_MAX_BYTES=5242880

# Image Security Pipeline Limits
# Decoded byte ceiling (default 7340032 = 7 MiB; encodes to ~9.8 MB Base64 within the 10 MB JSON limit)
IMAGE_MAX_BYTES=7340032
# Input pixel limit (default 50000000 = 50 MP, covering 48/50 MP modern phone sensors)
IMAGE_MAX_PIXELS=50000000
# Canonical JPEG output quality (0-100, default 90)
IMAGE_JPEG_QUALITY=90

# Audio Processing Pipeline (FFmpeg / FFprobe runtime configuration)
# Native executable paths (default to system PATH; can be overridden for custom binary locations)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_PROCESSING_TIMEOUT_MS=8000
AUDIO_PROCESSING_MAX_CONCURRENT=4

# Development & Test ONLY (strictly forbidden in production)
AI_VOICE_AGENT_MOCK_ENABLED=false

# Cloud Speech-to-Text (STT) Client (Provider Selection Pending Approval)
# SPEECH_SERVICE_MOCK_ENABLED enables in-memory mock STT client for development/testing
SPEECH_SERVICE_MOCK_ENABLED=false

# Rate Limiting (Token Bucket - In-Memory Process-Local)
VOICE_COMMAND_RATE_LIMIT_CAPACITY=10
VOICE_COMMAND_RATE_LIMIT_REFILL_RATE=1
VOICE_TRANSCRIBE_RATE_LIMIT_CAPACITY=3
VOICE_TRANSCRIBE_RATE_LIMIT_REFILL_RATE=0.2

# Account Deletion Audit & Anonymization
# Dedicated HMAC-SHA256 secret for anonymized user audit logs (required, minimum 16 characters, no fallback)
DELETION_HMAC_SECRET=your_deletion_hmac_secret_min_16_chars

# Active key version for deletion audit records (positive integer between 1 and 32767, defaults to 1)
DELETION_HMAC_KEY_VERSION=1

# Controls whether the background deletion worker actively polls and processes jobs (defaults to true)
# Set to false to disable background processing (e.g. during offline OpenAPI generation or maintenance)
DELETION_WORKER_ENABLED=true
