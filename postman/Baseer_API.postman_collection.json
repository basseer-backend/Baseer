  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically generate standard HS256 JWT token if not explicitly provided",
          "const secret = pm.variables.get('jwt_secret') || 'baseer-assistive-ai-default-secret-key-32-chars-long';",
          "const userId = pm.variables.get('user_id') || '11111111-1111-1111-1111-111111111111';",
          "",
          "function base64url(source) {",
          "    let encodedSource = CryptoJS.enc.Base64.stringify(source);",
          "    encodedSource = encodedSource.replace(/=+$/, '');",
          "    encodedSource = encodedSource.replace(/\\+/g, '-');",
          "    encodedSource = encodedSource.replace(/\\//g, '_');",
          "    return encodedSource;",
          "}",
          "",
          "const header = { alg: 'HS256', typ: 'JWT' };",
          "const now = Math.floor(Date.now() / 1000);",
          "const payload = {",
          "    sub: userId,",
          "    userId: userId,",
          "    isGuest: false,",
          "    iat: now,",
          "    exp: now + 86400",
          "};",
          "",
          "const stringifiedHeader = CryptoJS.enc.Utf8.parse(JSON.stringify(header));",
          "const encodedHeader = base64url(stringifiedHeader);",
          "",
          "const stringifiedPayload = CryptoJS.enc.Utf8.parse(JSON.stringify(payload));",
          "const encodedPayload = base64url(stringifiedPayload);",
          "",
          "const tokenData = encodedHeader + '.' + encodedPayload;",
          "const signature = CryptoJS.HmacSHA256(tokenData, secret);",
          "const encodedSignature = base64url(signature);",
          "",
          "const token = tokenData + '.' + encodedSignature;",
          "pm.variables.set('jwt_token', token);"
        ]
      }
    }
  ],
