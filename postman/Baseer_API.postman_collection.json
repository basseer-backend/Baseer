    {
      "name": "02 - Authentication",
      "description": "User registration, login, token refresh with rotation, guest access, profile, and logout.",
      "item": [
        {
          "name": "Guest Authentication (POST /auth/guest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Guest user and tokens created according to Baseer schema\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.user.id).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.user.isGuest).to.eql(true);",
                  "    pm.expect(jsonData.data.user.preferredLanguage).to.eql(\"ar-EG\");",
                  "    pm.expect(jsonData.data.tokens.accessToken).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.tokens.refreshToken).to.be.a(\"string\");",
                  "",
                  "    pm.environment.set(\"jwt_token\", jsonData.data.tokens.accessToken);",
                  "    pm.environment.set(\"refresh_token\", jsonData.data.tokens.refreshToken);",
                  "    pm.environment.set(\"user_id\", jsonData.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
